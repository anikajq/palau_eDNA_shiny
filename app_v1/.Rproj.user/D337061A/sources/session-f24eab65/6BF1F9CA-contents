# generate_cosmo_graph() to make the barplots out of whatever you want (how many stations count as cosmopolitan)
generate_cosmo_graph <- function() {
  print("this function is using the default_esv data")
  user_input <- readline(prompt = "how many stations would you like to look for connections across? (press c to cancel) ")
