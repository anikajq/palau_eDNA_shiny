make_zone_bar <- function(meta=default_meta, cosmo_df){
  zone_stn_df <- meta %>% 
    select(Station, Zone) %>% 
    dplyr::filter(Zone != "BLNK") %>% 
    distinct()
  stn_zone_freq <- cosmo_df %>% 
    left_join(y=zone_stn_df, by=c("station_num" = "Station"))
  barchart <- stn_zone_freq %>% 
    ggplot(aes(x = reorder(station_num, -Freq), y = Freq, fill=Zone)) +
    geom_col(color="black", linewidth=0.2) +
    ggtitle("number of cosmopolitan species by station") +
    xlab("station number") +
    ylab("number of cosmopolitan species")
    # scale_fill_viridis(discrete=TRUE, option = "mako")
  return(barchart)
}

