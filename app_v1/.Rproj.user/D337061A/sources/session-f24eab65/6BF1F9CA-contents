  cosmo_df <- cosmo_df %>%
    dplyr::filter((species_name != "Homo sapiens"), (species_name != "Sus scrofa")) # can comment this line out if desired
  cosmo_freq <- table(unlist(strsplit(cosmo_df$station_names, ", "))) # this creates a frequency table that counts the number of cosmopolitan species at each station
  cosmo_per_stn <- data.frame(cosmo_freq)
  cosmo_per_stn <- cosmo_per_stn %>%
    rename(station_num = Var1)
  make_zone_bar(default_meta, cosmo_per_stn) +
    ggtitle("Number of Cosmopolitan Species by Station", subtitle = paste("species found in", user_input, "or more stations (no humans/pigs)"))
}

