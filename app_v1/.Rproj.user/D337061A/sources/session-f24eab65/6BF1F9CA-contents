#### Dot Plots

To show the connectivity between species using dotplots:

Helper Functions:

```{r}
create_species_summary2 <- function(df) {
  # Generate list of species from the given data frame
  species_list <- species_list_df(df) %>%
    dplyr::filter(species_name != "")

  # Initialize an empty data frame to store the results
  summary_df <- data.frame(species_name = character(),
                           station = integer(),
                           stringsAsFactors = FALSE)

  # Iterate through each species
  for (species in species_list$species_name) {
    # Get species information
    species_info <- species_info_df(species)
    # Extract unique stations for the species
    unique_stations <- unique(species_info$Station[!is.na(species_info$Station)])
    # Only create a data frame if unique_stations is not empty
    if (length(unique_stations) > 0) {
      # Create a temporary data frame for the species with its stations
      temp_df <- data.frame(species_name = species,
                            station = unique_stations,
                            stringsAsFactors = FALSE)
      # Append the temporary data frame to the summary data frame
      summary_df <- rbind(summary_df, temp_df)
    }
  }
  return(summary_df)
}


dotplot_sp <- function(data){
  ggplot(data, aes(x = station, y = species_name, color=Zone)) +
    geom_point(size=2) +
    labs(x = "Station Number", y = "Species Name", title = "Species Presence at Sampling Stations") +
    theme_linedraw() +
    theme(
      panel.grid.major.x = element_line(color = "black", linewidth = 0.1),
      panel.grid.major.y = element_line(color = "black", linewidth = 0.3, linetype = "dotted"),
      panel.grid.minor = element_blank(), # Remove minor gridlines
      
      # Customize tick marks
      axis.ticks.x = element_line(color = "black", linewidth = 0.8),
      axis.ticks.y = element_line(color = "black", linewidth = 0.8),
      axis.ticks.length = unit(5, "pt") # Length of tick marks
    )
}
```

Final function to put everything together:

```{r}
# Be able to select certain species:
# plot_select_sp() takes in a vector of species names (or a dataframe column using the $ selection tool), a dataset, a metadata dataframe, and a boolean "faceting" depending on if you want the result to be faceted or not, The function produces a dot plot accordingly. 

# Default value for faceting = FALSE and By default, it takes in the default_esv and default_meta dataframes
plot_select_sp <- function(species_list, data=default_esv, meta=default_meta, faceting = FALSE){
  output <- create_species_summary2(data)
  output_filtered <- output %>% 
    dplyr::filter(species_name %in% species_list)
  zone_stn_df <- meta %>% 
    select(Station, Zone) %>% 
    dplyr::filter(Zone != "BLNK") %>% 
    distinct()
  stn_zone_output <- output_filtered %>% 
    left_join(y=zone_stn_df, by=c("station" = "Station"))
  stn_zone_output <- stn_zone_output %>%
    arrange(Zone, station)
  stn_zone_output$station <- factor(stn_zone_output$station, levels = unique(stn_zone_output$station))
  stn_zone_output$species_name <- factor(stn_zone_output$species_name, levels = sort(unique(stn_zone_output$species_name), decreasing = TRUE))
  result <- dotplot_sp(stn_zone_output)
  if (faceting == TRUE) {
    return (result + facet_wrap(~ Zone, scales = "free_x", nrow = 1))
  }
  else if (faceting == FALSE) {
    return(result)
  }
  else{errorCondition("faceting must be logical value")}
}
```

