zones_east <- list(c("FRR", "E"), c("LGN", "E"), c("SHR", "E"), c("AFZ", "E"), c("NMS", "E"))

cosmo_species_dir(example_list_dir, data=default_esv, meta=default_meta)
cosmo_species_dir(zones_east)

