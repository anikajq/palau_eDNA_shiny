set.seed(123)
x <- rnorm(1000)
y <- 5*x + rnorm(1000)
class1 <- sample(1000, 500)
y[class1] <- y[class1] + 0.3
y[-class1] <- y[-class1] - 0.3
plot(x[class1], y[class1], xlab="X", ylab="Y", ylim=c(-10, 10))
points(x[-class1], y[-class1], col="red")
z <- rep(1, 1000)
z[class1] <- -1
z[-class1] <- 1
data <- data.frame(x = x, y = y, z = as.factor(z))
tune.out <- tune(svm , z~., data = data , kernel = "linear", ranges = list(cost = c(0.001 , 0.01 , 0.1 , 1 ,5 ,10 ,100, 1000)))
tune.out <- tune(svm, z~., data = training_set, kernel = "linear", ranges = list(cost = c(0.01, 0.1, 1, 5, 10, 100, 1000, 10000)))
costs <- c(0.01, 0.1, 1, 5, 10, 100, 1000, 10000)
test_error <- rep(NA, length(costs))
for (i in 1:length(costs)) {
svm <- svm(z~., data = training_set, kernel = "linear", cost = costs[i])
pred <- predict(svm, test_set)
test_error[i] <- sum(pred != test_set$z)
}
test_error
test_error <- (test_error/length(test_set))
test_error
