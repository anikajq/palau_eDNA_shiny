ui <- fluidPage(
titlePanel("Forest Loss Dashboard (Anika Quon, version 5)"),
navset_tab(
id = "main_tabs",
title = NULL,  # optional title for the tabset
# Tab 1: About
tabPanel("About",
h3("About This Dashboard"),
includeHTML("~/Desktop/Stanford/Summers/WWF 2025/analysis_and_visualization/scripts/www/test_htm.html")
# p(about_tab)
),
# tab 2
tabPanel("Methodology",
h3("Methodology"),
p(method_tab)
),
# Tab 3: Tool
tabPanel("Tool",
sidebarLayout(
sidebarPanel(
fileInput("file", "Upload Excel file (.xlsx) with 'Year' and 'Forest_Loss (Ha)' columns"),
br(),
p("Please make sure that each landscape sheet begins with the following landscape titles in order to match the landscape drop-down menu; any sheets that do not begin with these codes will not be included"),
strong("Yucatan, MDD, Brazil, Madagascar, Vietnam"),
br(),
p("Note also that analysis will use only the 'Year' and 'Forest Loss' columns of the excel sheets; if there are more calculations/columns provided, they won't be used in analysis."),
br(), br(),
selectInput("landscape_choice", "Landscape", landscape_choices),
selectInput("baseline_yr", "Baseline Year", c("First 5 Years", "Years 5-10", "Combined")),
actionButton("calculate", "Calculate Carbon")
),
mainPanel(
conditionalPanel(
condition = "input.calculate > 0",
fluidRow(
column(3,
strong("Raw Data — Whole Landscape"),
textOutput("landscape_name"),
DTOutput("data_table")
),
column(3,
strong("Analysis — Whole Landscape"),
textOutput("landscape_name"),
DTOutput("render_df")
)
)
),
uiOutput("multi_plot_ui")
)
)
)
)
)
