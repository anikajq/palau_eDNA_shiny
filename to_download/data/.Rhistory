data = var_data,
# lat = ~jittered_lat,
# lng = ~jittered_lng,
lat = var_data$latitude,
lng = var_data$longitude,
label = paste(var_data$label, paste("Station Number:", var_data$station_number), paste(variable, ":", var_data[[col_name]]), sep= " | "),
radius = 9000, #can be adjusted!!
color = ~pal(var_data[[col_name]]),
stroke=FALSE,
fillOpacity = 0.8,
) %>%
addLegend(
position = "bottomright",
pal = pal,
values = var_data[[col_name]],
title = translate_variable_name(var),
)
return(map_fixed_rad)
}
server <- function(input, output, session) {
output$sal_text <- renderText({
"Mapping Environmental Data and Biodiversity in Palau's National Marine Sanctuary"
})
output$salinity_map <- renderLeaflet({
map_variable(var = input$env_var)
})
output$species_map <- renderLeaflet({
map_multi_species(input$sp_choice2)
})
}
